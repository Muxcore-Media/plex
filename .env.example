# Plex Media Server
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=

# Durable settings + catalog sync state
PLEX_DATA_DIR=/var/lib/muxcore-plex
PLEX_CATALOG_SYNC_SEC=21600

# HTTP API (GET /sync-lists) — required; empty secret rejects all requests
PLEX_HTTP_SECRET=

# Playback
PLEX_SESSIONS_POLL_SEC=30
PLEX_SSE=1
PLEX_SYNC_LIST_POLL_SEC=3600

# Listen addresses
PLEX_GRPC_ADDR=:9476
PLEX_HTTP_ADDR=:8476

# Core mesh (event publish)
MUXCORE_GRPC_ADDR=127.0.0.1:9090
MUXCORE_INSECURE_DISABLE_TLS=true
